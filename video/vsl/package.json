{
  "name": "wooplans-vsl",
  "private": true,
  "type": "module",
  "description": "VSL du Catalogue Premium en motion design, composée avec HyperFrames (HTML + GSAP) et rendue en MP4.",
  "scripts": {
    "prepare-media": "node prepare.mjs",
    "voice": "node voice.mjs",
    "build": "node build.mjs",
    "check": "hyperframes lint .",
    "render": "hyperframes render -q delivery -o out/vsl-master.mp4",
    "finish": "node finish.mjs"
  },
  "dependencies": {
    "hyperframes": "0.8.223"
  }
}
